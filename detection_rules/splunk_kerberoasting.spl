index=* EventCode=4769 | eval Ticket_Encryption_Type=case(TicketEncryptionType=="0x17", "RC4-HMAC (Vulnerable)", TicketEncryptionType=="0x12", "AES256", TicketEncryptionType=="0x11", "AES128", true(), TicketEncryptionType) | where ServiceName!="krbtgt" AND NOT match(ServiceName, "\$$") | stats count values(Ticket_Encryption_Type) as Encryption_Types by TargetUserName, ClientAddress, ServiceName, _time
